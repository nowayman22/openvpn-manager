// Allow the installing user to manage only openvpn-client@ units without a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "PROJECT_USER") {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("openvpn-client@") === 0) {
            return polkit.Result.YES;
        }
    }
});

// Allow the installing user to run the privileged topology helper (ARP scan,
// set-creds) without a password. The helper is root-owned at
// /usr/lib/openvpn-manager/helper.sh (installed by install.sh), so it cannot
// be tampered with to escalate privileges.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        subject.user == "PROJECT_USER") {
        var program = action.lookup("program");
        if (program && program === "/usr/lib/openvpn-manager/helper.sh") {
            return polkit.Result.YES;
        }
    }
});
